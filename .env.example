# Copia este archivo como ".env" y completa los valores. El archivo .env NO se sube a internet.
# Base de datos permanente (Turso). Sin estas dos líneas la landing usa un archivo local de prueba.
TURSO_DATABASE_URL=libsql://tu-base.turso.io
TURSO_AUTH_TOKEN=tu-token-aqui
# PIN de la administradora (para /admin). Solo se usa si la base todavía no tiene un PIN guardado.
ADMIN_PIN=
# Opcional: ID del Píxel de Meta (solo números).
META_PIXEL_ID=
